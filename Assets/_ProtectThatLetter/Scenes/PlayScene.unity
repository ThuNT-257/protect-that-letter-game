  vietnameseQuestions:
  - question: "M\u1ED9t ng\u01B0\u1EDDi cao 170cm \u0111\u1EE9ng c\u1EA1nh m\u1ED9t
      ng\u01B0\u1EDDi cao 170cm. Kho\u1EA3ng c\xE1ch gi\u1EEFa \u0111\u1EC9nh \u0111\u1EA7u
      c\u1EE7a hai ng\u01B0\u1EDDi l\xE0 bao nhi\xEAu?"
    options:
    - 0cm
    - 10cm
    - 17cm
    - 34cm
    correctIndex: 0
  - question: "N\u1EBFu Thu ph\u1EA3i ch\u1ECDn gi\u1EEFa KFC v\xE0 Lotteria, b\u1EA1n
      ngh\u0129 Thu s\u1EBD ch\u1ECDn g\xEC?"
    options:
    - Lotteria
    - KFC
    correctIndex: 1
  - question: "C\xF3 5 ng\u01B0\u1EDDi c\xF9ng \u0103n t\u1ED1i. M\u1ED7i ng\u01B0\u1EDDi
      b\u1EAFt tay v\u1EDBi m\u1ED7i ng\u01B0\u1EDDi kh\xE1c \u0111\xFAng m\u1ED9t
      l\u1EA7n. T\u1ED5ng c\u1ED9ng c\xF3 bao nhi\xEAu c\xE1i b\u1EAFt tay?"
    options:
    - 5
    - 10
    - 15
    - 20
    correctIndex: 1
  - question: "M\u1ED9t l\u1ECD m\u1EA5t nh\xE3n ch\u1EE9a m\u1ED9t dung d\u1ECBch
      kh\xF4ng m\xE0u. Khi nh\u1ECF v\xE0i gi\u1ECDt qu\u1EF3 t\xEDm v\xE0o, dung
      d\u1ECBch chuy\u1EC3n sang m\xE0u \u0111\u1ECF. V\u1EADy t\xEAn \u0111\u1EA7y
      \u0111\u1EE7 c\u1EE7a Thu l\xE0?"
    options:
    - "Nguy\u1EC5n Th\u1ECB Thu"
    - "Tr\u1EA7n Th\u1ECB Thu"
    - "Nguy\u1EC5n Th\u1ECB Thanh Thu"
    - "Nguy\u1EC5n Thanh Thu"
    correctIndex: 3
  - question: "Khi \u0111i quan s\xE1t v\xE0 h\u1ECDc h\u1ECFi th\u1EF1c t\u1EBF,
      ch\xFAng ta n\xEAn d\xF9ng t\u1EEB n\xE0o d\u01B0\u1EDBi \u0111\xE2y?"
    options:
    - Tham quan
    - "Th\u0103m quan"
    correctIndex: 0
  englishQuestions:
  - question: You are running a race and you overtake the person in second place.
      What place are you in now?
    options:
    - 1st
    - 2nd
    - 3rd
    - Last
    correctIndex: 0
  - question: Of all the fried chicken chains, which one do you think is Thu's favorite?
    options:
    - Jollibee
    - KFC
    - Texas Chicken
    - Lotteria
    correctIndex: 2
  - question: A farmer has 17 sheep. All but 9 run away. How many sheep are left?
    options:
    - 8
    - 17
    - 9
    - 0
    correctIndex: 3
  - question: If Thu could travel to one country right now, which one would Thu choose?
    options:
    - Japan
    - South Korea
    - Switzerland
    - Thailand
    correctIndex: 0
  - question: Ted and Amy _____ for 24 years.
    options:
    - have been married
    - married
    - were married
    - has been married
    correctIndex: 0
